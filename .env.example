# Backend (copy to backend/.env or repo root — load_dotenv looks at cwd)
CHETYA_JWT_SECRET=change-me-in-production
ANTHROPIC_API_KEY=

# Primary store: omit for default SQLite at ./data/chetya.sqlite (created automatically).
# DATABASE_URL=sqlite:////absolute/path/to/chetya.sqlite
# DATABASE_URL=postgresql+psycopg://chetya:chetya@localhost:5432/chetya

# Optional mirror (leave unset for SQL-only)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
